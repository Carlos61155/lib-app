generator client {
  provider = "prisma-client"
  output   = "../electron/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Person {
  id        String   @id @default(uuid())
  cpf       String   @unique
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  librarian Librarian?
  student   Student?
  professor Professor?

  registrationLogs RegistrationLog[]

  @@map("people")
}

model Librarian {
  id                  String    @id @default(uuid())
  personId            String    @unique @map("person_id")
  accessCode          String    @unique @map("access_code")
  passwordHash        String    @map("password_hash")
  isActive            Boolean   @default(true) @map("is_active")
  mustChangePassword  Boolean   @default(true) @map("must_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  person                  Person                  @relation(fields: [personId], references: [id], onDelete: Restrict)
  accessLogs              AccessLog[]
  registrationsMade       RegistrationLog[]       @relation("RegistrationCreatedBy")
  authorRegistrationsMade RegistrationAuthorLog[] @relation("AuthorRegistrationCreatedBy")
  genreRegistrationsMade  RegistrationGenreLog[]  @relation("GenreRegistrationCreatedBy")
  bookRegistrationsMade   RegistrationBookLog[]   @relation("BookRegistrationCreatedBy")

  @@map("librarians")
}

model Student {
  id                 String   @id @default(uuid())
  personId           String   @unique @map("person_id")
  registrationNumber String   @unique @map("registration_number")
  course             String
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@map("students")
}

model Professor {
  id                 String   @id @default(uuid())
  personId           String   @unique @map("person_id")
  department         String
  registrationNumber String   @unique @map("registration_number")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@map("professors")
}

model AccessLog {
  id                  String   @id @default(uuid())
  librarianId         String?  @map("librarian_id")
  attemptedAccessCode String   @map("attempted_access_code")
  success             Boolean
  failureReason       String?  @map("failure_reason")
  createdAt           DateTime @default(now()) @map("created_at")

  librarian Librarian? @relation(fields: [librarianId], references: [id], onDelete: SetNull)

  @@map("access_logs")
}

model RegistrationLog {
  id                   String   @id @default(uuid())
  personId             String   @map("person_id")
  createdByLibrarianId String?  @map("created_by_librarian_id")
  createdAt            DateTime @default(now()) @map("created_at")

  person             Person     @relation(fields: [personId], references: [id], onDelete: Restrict)
  createdByLibrarian Librarian? @relation("RegistrationCreatedBy", fields: [createdByLibrarianId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@index([createdByLibrarianId, createdAt])
  @@map("registration_logs")
}

model Author {
  id          String    @id @default(uuid())
  name        String
  nationality String
  pseudonym   String?
  dateOfBirth DateTime? @map("date_of_birth")
  dateOfDeath DateTime? @map("date_of_death")
  biography   String?
  isActive    Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  registrationLogs RegistrationAuthorLog[]
  books            BookAuthor[]

  @@map("authors")
}

model RegistrationAuthorLog {
  id                   String   @id @default(uuid())
  authorId             String   @map("author_id")
  createdByLibrarianId String   @map("created_by_librarian_id")
  createdAt            DateTime @default(now()) @map("created_at")

  author             Author    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdByLibrarian Librarian @relation("AuthorRegistrationCreatedBy", fields: [createdByLibrarianId], references: [id], onDelete: Restrict)

  @@index([authorId])
  @@index([createdByLibrarianId, createdAt])
  @@map("registration_author_logs")
}

model Genre {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  registrationGenreLogs RegistrationGenreLog[]
  books                 BookGenre[]

  @@map("genres")
}

model RegistrationGenreLog {
  id                   String   @id @default(uuid())
  genreId              String   @map("genre_id")
  createdByLibrarianId String   @map("created_by_librarian_id")
  createdAt            DateTime @default(now()) @map("created_at")

  genre              Genre     @relation(fields: [genreId], references: [id], onDelete: Restrict)
  createdByLibrarian Librarian @relation("GenreRegistrationCreatedBy", fields: [createdByLibrarianId], references: [id], onDelete: Restrict)

  @@index([genreId])
  @@index([createdByLibrarianId, createdAt])
  @@map("registration_genre_logs")
}

model Book {
  id                String @id @default(uuid())
  title             String
  isbn              String @unique
  publisher         String
  yearOfPublication Int    @map("year_of_publication")

  subTitle      String?
  edition       String?
  numberOfPages Int?    @map("number_of_pages")
  language      String?
  synopsis      String?
  coverPath     String? @map("cover_path")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  registrationLogs RegistrationBookLog[]
  authors           BookAuthor[]
  genres            BookGenre[]

  @@map("books")
}

model RegistrationBookLog {
  id                   String   @id @default(uuid())
  bookId               String   @map("book_id")
  createdByLibrarianId String   @map("created_by_librarian_id")
  createdAt            DateTime @default(now()) @map("created_at")

  book                 Book      @relation(fields: [bookId], references: [id], onDelete: Restrict)
  createdByLibrarian   Librarian @relation("BookRegistrationCreatedBy", fields: [createdByLibrarianId], references: [id], onDelete: Restrict)

  @@index([bookId])
  @@index([createdByLibrarianId, createdAt])
  @@map("registration_book_logs")
}

model BookAuthor {
  bookId   String @map("book_id")
  authorId String @map("author_id")

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@id([bookId, authorId])
  @@index([authorId])
  @@map("book_authors")
}

model BookGenre {
  bookId  String @map("book_id")
  genreId String @map("genre_id")

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([bookId, genreId])
  @@index([genreId])
  @@map("book_genres")
}
